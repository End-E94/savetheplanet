{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#fbfaf5"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#1b2a1f"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#2d6a4f"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#8a6a3b"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#95d5b2"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#e9efe3"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "Georgia, Times, serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.125rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.5rem, 1.2rem + 1.2vw, 2rem)"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "30",
					"name": "Small",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "Extra Large",
					"size": "clamp(3rem, 2rem + 4vw, 5rem)"
				}
			]
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "header-shop",
			"title": "Shop Header",
			"area": "header"
		}
	],
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"lineHeight": "1.2"
				}
			}
		},
		"css": ":where(a, button, .wp-element-button, input, select, textarea):focus-visible { outline: 3px solid var(--wp--preset--color--primary); outline-offset: 2px; }"
	}
}
